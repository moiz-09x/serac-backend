# Copy to .env and fill in for local development.

ENVIRONMENT=development

# Knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain_local

# Application DB + vector store (Postgres/pgvector, single instance for v1)
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/brain

# Cache / dedup / job queue backend
REDIS_URL=redis://localhost:6379/0

# LLM provider
ANTHROPIC_API_KEY=
MICRO_AGENT_MODEL=claude-haiku-4-5-20251001
SYNTHESIS_MODEL=claude-sonnet-4-6
