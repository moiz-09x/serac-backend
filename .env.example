ENVIRONMENT=development

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain_local
NEO4J_DATABASE=neo4j

POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/brain

REDIS_URL=redis://localhost:6379/0

# ── Server ────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000

# ── OAuth security ────────────────────────────────────────────────────────────
# AES-256 key for encrypting tokens at rest: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# HMAC secret for signing OAuth state params: openssl rand -hex 32
OAUTH_STATE_SECRET=

# ── OAuth app credentials ─────────────────────────────────────────────────────
# Notion — notion.so/my-integrations → Public integration → OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Linear — linear.app → Settings → API → OAuth Applications
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Slack — api.slack.com/apps → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Provider API keys ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ── Agent model configs ───────────────────────────────────────────────────────
# Query decomposition: breaks a natural-language question into sub-queries
DECOMPOSITION_PROVIDER=deepseek
DECOMPOSITION_MODEL=deepseek-v4-flash

# Synthesis: reads retrieved context and writes the cited answer
SYNTHESIS_PROVIDER=deepseek
SYNTHESIS_MODEL=deepseek-v4-flash

# ── Connectors (legacy / self-hosted fallback) ────────────────────────────────
# Generate once: python -c "import uuid; print(uuid.uuid4())"
TENANT_ID=

# Linear — fallback API key for self-hosted (OAuth preferred)
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=

# Slack — "socket" for local/self-hosted, "webhook" for cloud deployment
SLACK_MODE=socket
# Socket Mode (local/self-hosted): api.slack.com/apps → Socket Mode → App-Level Tokens (xapp-...)
SLACK_APP_TOKEN=
# Bot token: api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Signing secret (webhook mode only): api.slack.com/apps → Basic Information
SLACK_SIGNING_SECRET=

# Notion — fallback API key for self-hosted (OAuth preferred)
NOTION_API_KEY=
NOTION_WEBHOOK_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
THREAD_ATTACH_THRESHOLD=0.65
RETRIEVAL_MIN_SCORE=0.72

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
