ENVIRONMENT=development

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brain_local
NEO4J_DATABASE=neo4j

POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/brain

REDIS_URL=redis://localhost:6379/0

# ── Provider API keys ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ── Agent model configs ───────────────────────────────────────────────────────
# Query decomposition: breaks a natural-language question into sub-queries
DECOMPOSITION_PROVIDER=deepseek
DECOMPOSITION_MODEL=deepseek-v4-flash

# Synthesis: reads retrieved context and writes the cited answer
SYNTHESIS_PROVIDER=deepseek
SYNTHESIS_MODEL=deepseek-v4-flash

# ── Connectors ────────────────────────────────────────────────────────────────
# Generate once: python -c "import uuid; print(uuid.uuid4())"
TENANT_ID=

# Linear — Settings → API → Personal API keys
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=

# Slack — both required to enable the Slack connector
# SLACK_APP_TOKEN:  api.slack.com/apps → your app → Socket Mode → App-Level Tokens (xapp-...)
# SLACK_BOT_TOKEN:  api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
THREAD_ATTACH_THRESHOLD=0.65
RETRIEVAL_MIN_SCORE=0.72

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
